# Copy this file to ".env" for local development and fill in YOUR values.
# Never commit the real .env file. On Render, set these in the dashboard instead.

# MongoDB Atlas connection string (keep the real one only in .env / Render).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/<database>?retryWrites=true&w=majority

# Optional: database name, if it is not already in the connection string path.
MONGO_DB_NAME=my-page

# The access code required to SAVE changes to the page. You choose it.
# It is checked on the server only — it never appears in the website code.
EDIT_CODE=choose-your-own-edit-code

# The public URL of the client site (comma-separate several if needed).
CLIENT_URL=http://localhost:5173

PORT=5000
