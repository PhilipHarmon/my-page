# Copy this file to ".env" for local development and fill in YOUR values.
# On Render these are set on the static site service instead (they are
# baked into the build, so change them = redeploy).

# Where the API lives. Local dev default:
VITE_API_URL=http://localhost:5000/api

# Optional — photo/video uploads via Cloudinary (unsigned preset, the same
# pattern as Photo Journal). Leave blank and uploads are simply turned off;
# pasting links still works.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
