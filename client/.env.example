# Copy this file to ".env" for local development and fill in YOUR values.
# On Render these are set on the static site service instead (they are
# baked into the build, so change them = redeploy).

# Where the API lives. Local dev default:
VITE_API_URL=http://localhost:5000/api

# That's the only client variable. Photo/video uploads go through the
# API itself (stored in the page's own MongoDB) — there is nothing
# else to configure.
